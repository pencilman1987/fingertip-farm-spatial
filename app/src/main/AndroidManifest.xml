<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

        <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FingertipFarmSpatialTheme"
        tools:targetApi="31">

        <meta-data
            android:name="com.pico.spatial.SPATIAL_APP"
            android:value="true" />

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.FingertipFarmSpatialTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The default planar WindowContainer keeps the app in Shared Space. -->
            <meta-data android:name="pico.spatial.windowcontainer.id" android:value="FingertipFarmWindow" />
            <meta-data android:name="pico.spatial.windowcontainer.style" android:value="1" />
            <meta-data android:name="pico.spatial.windowcontainer.defaultsize" android:value="1200x800" />
            <meta-data android:name="pico.spatial.windowcontainer.defaultsize.unit" android:value="dp" />
            <meta-data android:name="pico.spatial.windowcontainer.resizetype" android:value="1" />
            <meta-data android:name="pico.spatial.windowcontainer.resizerestriction" android:value="0" />
            <meta-data android:name="pico.spatial.windowcontainer.worldscaletype" android:value="1" />
            <meta-data android:name="pico.spatial.windowcontainer.captionbar" android:value="0" />
            <meta-data android:name="pico.spatial.windowcontainer.materialbackground" android:value="1" />
        </activity>
        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
